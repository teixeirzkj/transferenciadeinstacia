      "parameters": {
        "jsCode": "const m = $input.first().json || {};\nconst p = $('Validar pedido').first().json;\nif (m.status === 'FAILED') {\n  return [{ json: { ok: false, erro: 'O Helena recusou o envio: ' + (m.failureReason || 'motivo não informado') } }];\n}\nreturn [{ json: { ok: true, encerrar: p.encerrar, sessionId: p.sessionId, novoSessionId: m.sessionId || null } }];"
