        "url": "=https://api.helena.run/chat/v1/template?channelId={{ $json.destino.id }}&approvedOnly=true&archived=false&pageSize=100{{ $json.templateIdFixo ? '' : '&name=' + encodeURIComponent($json.templateName) }}",
