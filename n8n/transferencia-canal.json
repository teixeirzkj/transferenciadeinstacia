    {
      "parameters": {
        "jsCode": "const p = $('Validar pedido').first().json;\nconst r = $input.first().json || {};\nconst itens = Array.isArray(r.items) ? r.items : [];\n\nconst tpl = p.templateIdFixo\n  ? (itens.find((t) => t.id === p.templateIdFixo) || { id: p.templateIdFixo, params: [] })\n  : itens.find((t) => t.name === p.templateName);\n\nif (!tpl) {\n  return [{ json: { ok: false, erro: 'O número ' + p.destino.nome + ' não tem template aprovado chamado \"' + p.templateName + '\".' } }];\n}\n\n// Variáveis do template preenchidas com o que se sabe do cliente.\n// A Meta recusa variável vazia, então sempre vai algum valor.\nconst primeiro = (p.cliente.nome || '').trim().split(/\\s+/)[0] || '';\nconst valores = {\n  nome: primeiro, primeiro_nome: primeiro, nome_cliente: primeiro,\n  nome_completo: (p.cliente.nome || '').trim(),\n  telefone: p.cliente.telefone,\n  empresa_origem: p.origemNome, canal_origem: p.origemNome,\n};\nconst parameters = {};\nfor (const par of (tpl.params || [])) {\n  const k = String(par.name || '');\n  if (!k) continue;\n  const v = valores[k.toLowerCase()] ?? (k.toLowerCase().includes('nome') ? primeiro : '');\n  parameters[k] = v || (k.toLowerCase().includes('nome') ? 'cliente' : '-');\n}\n\nconst body = { templateId: tpl.id };\nif (Object.keys(parameters).length) body.parameters = parameters;\n\nreturn [{ json: {\n  ok: true,\n  payload: {\n    from: p.destino.telefone,\n    to: p.cliente.telefone,\n    body,\n    options: { enableBot: false, hiddenSession: false, forceStartSession: true },\n  },\n} }];"
      },
