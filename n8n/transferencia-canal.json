    {
      "parameters": {
        "jsCode": "// ================= CONFIG =================\n// URL do Webhook Transferir. Vazio = monta sozinho com o domínio deste n8n.\nconst WEBHOOK_TRANSFERIR = '';\n// Opcional: renomear números na tela  { '5582999990001': 'Loja Centro' }\nconst NOMES = {};\n// Opcional: mostrar só estes números (vazio = todos)\nconst PERMITIDOS = [];\n// ==========================================\n\nconst d = (v) => String(v || '').replace(/\\D/g, '');\nconst wh = $('Webhook Tela').first().json;\nconst q = wh.query || {};\nconst h = wh.headers || {};\n\nconst brutos = $('Listar canais').all().map((i) => i.json);\nconst falhouLista = brutos.length > 0 && brutos.every((c) => c.error);\nconst canais = brutos\n  .filter((c) => c && !c.error && c.id && c.active !== false && d(c.number))\n  .map((c) => ({\n    id: c.id,\n    telefone: d(c.number),\n    nome: NOMES[d(c.number)] || NOMES[c.id] || c.identity?.displayName || c.numberFormatted || d(c.number),\n  }))\n  .filter((c) => !PERMITIDOS.length || PERMITIDOS.includes(c.telefone) || PERMITIDOS.includes(c.id))\n  .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));\n\nconst s = $('Buscar sessão').first().json || {};\nconst temSessao = !s.error && !!s.id;\n\nconst host = h['x-forwarded-host'] || h.host;\nconst proto = String(h['x-forwarded-proto'] || 'https').split(',')[0];\n\nlet erro = '';\nif (falhouLista) erro = 'Não consegui listar os números da conta. Verifique a credencial do Helena no n8n.';\nelse if (q.sessionId && !temSessao) erro = 'Não achei esse atendimento no Helena.';\n\nconst dados = {\n  k: q.k || '',\n  sessionId: temSessao ? s.id : '',\n  canalAtualId: temSessao ? (s.channelId || '') : '',\n  cliente: {\n    nome: (temSessao && s.contactDetails?.name) || q.nome || '',\n    telefone: d((temSessao && s.contactDetails?.phonenumber) || q.telefone),\n  },\n  canais,\n  webhookTransferir: WEBHOOK_TRANSFERIR || proto + '://' + host + '/webhook/transferir-canal',\n  erro,\n};\n\nconst html = String($input.first().json.data || '');\nif (!html.includes('__DADOS__')) {\n  throw new Error('O HTML baixado da Vercel não tem o marcador de dados. Confira a URL no nó \"Baixar HTML (Vercel)\".');\n}\n// \"<\" escapado pra nenhum texto conseguir fechar a tag <script>\nconst json = JSON.stringify(dados).replace(/</g, '\\\\u003c');\nreturn [{ json: { html: html.split('__DADOS__').join(json) } }];"
      },
