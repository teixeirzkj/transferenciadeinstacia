    {
      "parameters": {
        "jsCode": "// ================= CONFIG =================\n// Nome do template aprovado que existe em CADA número de destino\nconst TEMPLATE_NAME = 'transferencia_atendimento';\n// Opcional: número que usa template com outro nome -> id do template\n// { '5582999990001': '3fa85f64-5717-4562-b3fc-2c963f66afa6' }\nconst MAPA_TEMPLATE = {};\n// ==========================================\n\nconst d = (v) => String(v || '').replace(/\\D/g, '');\nconst b = $('Webhook Transferir').first().json.body || {};\nconst falha = (erro) => [{ json: { ok: false, erro } }];\n\nconst canais = $('Listar canais (T)').all().map((i) => i.json)\n  .filter((c) => c && !c.error && c.id && d(c.number));\nconst nomeDe = (c) => c.identity?.displayName || c.numberFormatted || d(c.number);\n\nconst s = $input.first().json || {};\nconst temSessao = !s.error && !!s.id;\nconst canalAtualId = temSessao ? s.channelId : '';\nconst cliente = {\n  nome: (temSessao && s.contactDetails?.name) || b.nome || '',\n  telefone: d((temSessao && s.contactDetails?.phonenumber) || b.telefone),\n};\n\n// O telefone de destino sai da lista da conta, nunca do navegador.\nconst destino = canais.find((c) => c.id === b.canalDestinoId);\nconst origem = canais.find((c) => c.id === canalAtualId);\n\nif (!canais.length) return falha('Não consegui listar os números da conta. Verifique a credencial do Helena no n8n.');\nif (!destino) return falha('Número de destino inválido.');\nif (destino.id === canalAtualId) return falha('Esse já é o número do atendimento atual.');\nif (b.sessionId && !temSessao) return falha('Não achei esse atendimento no Helena.');\nif (!cliente.telefone) return falha('Não achei o telefone do cliente nesse atendimento.');\n\nreturn [{ json: {\n  ok: true,\n  sessionId: temSessao ? s.id : '',\n  encerrar: b.encerrarOrigem === true && temSessao,\n  cliente,\n  destino: { id: destino.id, telefone: d(destino.number), nome: nomeDe(destino) },\n  origemNome: origem ? nomeDe(origem) : '',\n  templateName: TEMPLATE_NAME,\n  templateIdFixo: MAPA_TEMPLATE[d(destino.number)] || MAPA_TEMPLATE[destino.id] || '',\n} }];"
      },
