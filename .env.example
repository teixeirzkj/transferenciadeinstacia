# Token da API do Helena: Configurações > Integrações > Integração via API
HELENA_TOKEN=

# Chave que vai no link do botão (?k=...). Gere uma longa e aleatória.
ACCESS_KEY=

# Nome do modelo de mensagem (template) aprovado que existe em CADA número de destino
TEMPLATE_NAME=transferencia_atendimento

# --- Opcionais ---
# Se algum número usar template com outro nome: {"<id ou número do canal>": "<templateId>"}
# TEMPLATE_MAP={"5582999990001":"3fa85f64-5717-4562-b3fc-2c963f66afa6"}

# Mostrar só alguns números (ids ou números separados por vírgula)
# CANAIS_PERMITIDOS=5582999990001,5582999990002

# Renomear números na tela: {"<id ou número>": "Loja Centro"}
# NOMES_CANAIS={"5582999990001":"Loja Centro"}

# HELENA_API_URL=https://api.helena.run
